                        "expr": "sum(rate(kafka_records_valid_total{job=\"app-metrics\",namespace=~\"$namespace\",app=~\"$app\",component=~\"$component\"}[$__rate_interval])) + sum(rate(kafka_records_invalid_total{job=\"app-metrics\",namespace=~\"$namespace\",app=~\"$app\",component=~\"$component\"}[$__rate_interval]))",
