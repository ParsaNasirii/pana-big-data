      "panel-13": {
        "kind": "Panel",
        "spec": {
          "id": 13,
          "title": "Host CPU Usage",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "100 - (avg by (host) (rate(node_cpu_seconds_total{job=\"node\",host=~\"$host\",mode=\"idle\"}[$__rate_interval])) * 100)",
                        "legendFormat": "{{host}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "displayMode": "table",
                  "placement": "bottom"
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "min": 0,
                  "max": 100
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-14": {
        "kind": "Panel",
        "spec": {
          "id": 14,
          "title": "Root Filesystem Usage",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node\",host=~\"$host\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{job=\"node\",host=~\"$host\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"})",
                        "legendFormat": "{{host}}",
                        "range": true
