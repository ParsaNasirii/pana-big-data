          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "starrocks"
                      },
                      "group": "mysql",
                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "panabigdata",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    COALESCE(SUM(n.IN_BYTES), 0) AS totalIn,\n    COALESCE(SUM(n.OUT_BYTES), 0) AS totalOut\nFROM panabigdata.${table} n\nWHERE n.KAFKA_TIMESTAMP_MS BETWEEN ${__from} AND ${__to}\n  AND n.KAFKA_DAY BETWEEN\n      CAST(FROM_UNIXTIME(${__from} DIV 1000) AS DATE)\n      AND CAST(FROM_UNIXTIME(${__to} DIV 1000) AS DATE)\n  AND n.IPV4_SRC_ADDR = '${src_ip}'\n  AND n.IPV4_DST_ADDR = '${dst_ip}';",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        },
                        "table": "netflow_raw"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Total ingress and egress bytes for the selected directed IP pair and dashboard time range.",
          "id": 1,
          "links": [],
