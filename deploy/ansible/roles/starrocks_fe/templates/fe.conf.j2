sys_log_dir = {{ starrocks_fe_log_dir }}
audit_log_dir = {{ starrocks_fe_log_dir }}
internal_log_dir = {{ starrocks_fe_log_dir }}
big_query_log_dir = {{ starrocks_fe_log_dir }}
profile_log_dir = {{ starrocks_fe_log_dir }}
